# ==============================================================================
# YES 2026 SUMMIT - ENVIRONMENT & SUPABASE DATABASE CONFIGURATION
# Organized by Visvesvaraya Research and Innovation Foundation (VRIF), Belagavi
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD POSTGRESQL CONNECTION (RECOMMENDED)
# ------------------------------------------------------------------------------
# How to get your connection string from Supabase:
# 1. Log in to https://supabase.com/dashboard
# 2. Select your project -> Click "Project Settings" (gear icon at bottom left)
# 3. Click "Database" in the settings menu
# 4. Scroll to "Connection string" -> Select "URI" -> Mode: "Transaction" (or "Session")
# 5. Paste the string below (be sure to replace [YOUR-PASSWORD] with your actual database password):
#
# Example (Transaction Pooler - Port 6543):
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Example (Direct Connection - Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. CONNECTION POOL CONFIGURATION
# ------------------------------------------------------------------------------
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT=10

# ------------------------------------------------------------------------------
# 3. ADMIN CREDENTIALS & SECURITY
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nexus2026admin
SECRET_KEY=yes-2026-vrif-enterprise-secret-key-prod-belagavi

# ------------------------------------------------------------------------------
# 4. SERVER SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
HOST=0.0.0.0
PORT=5000
HTTPS_PORT=5443
